# Application Configuration
NEXT_PUBLIC_APP_NAME="FlowSync Treasury Ops"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Core Backend Endpoint
NEXT_PUBLIC_CORE_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:8080"

# Authentication & Cookies
COOKIE_TOKEN_NAME="flowsync_token"
COOKIE_REFRESH_TOKEN_NAME="flowsync_rtoken"
COOKIE_DOMAIN=""

# Security & Encryption (AES-CBC)
NEXT_PUBLIC_ENABLE_ENCRYPT="false"
AES_SECRET_KEY="replace_with_secure_32_byte_aes_key"
AES_IV_KEY="replace_16_bytes"

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE="vi"
NEXT_PUBLIC_LOCALES="vi,en"
